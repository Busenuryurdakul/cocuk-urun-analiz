# Miyuna — local development environment variables
# Copy to .env and adjust as needed

# Go API
API_PORT=8080
API_HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/miyuna
REDIS_URL=redis://localhost:6379/0
AGENT_ORCHESTRATOR_URL=http://localhost:8090

# Object storage (MinIO dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=miyuna
S3_SECRET_KEY=miyuna-dev-secret
S3_BUCKET=miyuna-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Mail (MailHog dev)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=noreply@miyuna.local

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
MFA_ISSUER=Miyuna
COOKIE_SECURE=false

# Auth security (dev only — rotate in production)
JWT_SECRET=change-me-jwt-dev-secret-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_OTP_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# Agent orchestrator (internal)
AGENT_PORT=8090
AGENT_HOST=127.0.0.1

# Credentials encryption (dev only — rotate in production)
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-dev-key-xx
