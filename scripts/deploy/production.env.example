# Miyuna production env — copy to secrets, never commit filled values.
RENDER_API_SERVICE_ID=srv-dae8m7dbedkc73ajnipg
RENDER_AGENT_SERVICE_ID=srv-dae8k10u01pc73dhddp0
RENDER_API_URL=https://miyuna-api.onrender.com
RENDER_AGENT_URL=https://miyuna-agent.onrender.com
WEB_BASE_URL=https://miyuna-web.vercel.app

# MongoDB Atlas M0 (Frankfurt): https://cloud.mongodb.com/
# Network Access (Render miyuna-api outbound, Frankfurt):
#   74.220.51.0/24
#   74.220.59.0/24
# Atlas -> Network Access -> Add IP Address -> paste both CIDRs
# Quick create (restart terminal after winget install, or use full path):
#   & "C:\Program Files (x86)\MongoDB Atlas CLI\atlas.exe" setup --clusterName miyuna-prod --provider AWS --region EU_CENTRAL_1 --username miyuna_app --currentIp --connectWith skip
# Or scripted:
#   .\scripts\deploy\provision_atlas_cluster.ps1
MONGODB_URI=

# Reuse existing free Redis (db 1) or create miyuna-redis via render-free.yaml
REDIS_URL=redis://red-da0tqr7lk1mc738palig:6379/1

# Optional Hugging Face for LLM routing (when Render private LLM not provisioned)
HF_TOKEN=

# LLM backend for configure_render_production.ps1: huggingface | render
LLM_BACKEND=huggingface

# One-shot production deploy (Atlas CLI logged in):
#   .\scripts\deploy\setup_atlas_user_and_deploy.ps1
# Or paste URI manually:
#   .\scripts\deploy\complete_production_deploy.ps1
# Render Ollama LLM (paid):
#   .\scripts\deploy\complete_production_deploy.ps1 -ProvisionRenderLlm -LlmBackend render

# Production SMTP (required for verification emails — not MailHog):
# Resend (free): https://resend.com/api-keys
#   MAIL_SMTP_HOST=smtp.resend.com
#   MAIL_SMTP_PORT=465
#   MAIL_SMTP_USER=resend
#   MAIL_SMTP_PASS=re_...
#   MAIL_SMTP_TLS=true
#   MAIL_FROM=onboarding@resend.dev
# Then: .\scripts\deploy\update_render_mail_env.ps1
