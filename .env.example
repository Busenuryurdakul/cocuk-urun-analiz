# Miyuna — local development environment variables
# Copy to .env and adjust as needed

# Go API
API_PORT=8080
API_HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/miyuna
REDIS_URL=redis://localhost:6379/0
AGENT_ORCHESTRATOR_URL=http://localhost:8090

# Object storage (MinIO dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=miyuna
S3_SECRET_KEY=miyuna-dev-secret
S3_BUCKET=miyuna-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Mail (MailHog dev)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=noreply@miyuna.local
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_TLS=false
MAIL_QUEUE_ENABLED=true
MAIL_RETRY_MAX=3

# Cloudflare Turnstile (optional in dev)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Login email OTP
LOGIN_EMAIL_OTP_TTL=10m

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
MFA_ISSUER=Miyuna
COOKIE_SECURE=false

# Auth security (dev only — rotate in production)
JWT_SECRET=change-me-jwt-dev-secret-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_OTP_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# Agent orchestrator (internal)
AGENT_PORT=8090
AGENT_HOST=127.0.0.1
GO_API_URL=http://127.0.0.1:8080
INTERNAL_TOKEN=dev-internal-token-change-me
AGENT_INTERNAL_TOKEN=dev-internal-token-change-me

# LLM gateway — local OpenAI-compatible runtime (Ollama / LM Studio / llama.cpp server)
# Run scripts/phase6/run_phase6_local_verification.ps1 to auto-discover models and set these for the shell session.
LLM_USE_MOCK=false
LLM_PRIMARY_BASE_URL=http://127.0.0.1:11434/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL_NAME=qwen2.5:0.5b
LLM_SECONDARY_BASE_URL=http://127.0.0.1:11434/v1
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL_NAME=llama3.2:latest
LOCAL_LLM_API_KEY=

# LLM gateway — Hugging Face Inference Providers (cloud alternative)
# LLM_PRIMARY_BASE_URL=https://router.huggingface.co/v1
# LLM_PRIMARY_API_KEY=
# LLM_SECONDARY_BASE_URL=https://router.huggingface.co/v1
# LLM_SECONDARY_API_KEY=
# HF_TOKEN=

# Credentials encryption (dev only — rotate in production)
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-dev-key-xx
