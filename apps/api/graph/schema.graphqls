schema {
  query: Query
  mutation: Mutation
}

type Query {
  """Platform health probe for GraphQL layer"""
  health: String!
  """Authenticated user profile"""
  me: User
  """Workspaces the current user belongs to"""
  myWorkspaces: [Workspace!]!
  """Organization details — tenant-isolated"""
  organization(organizationId: ID!): Organization
  """Members of an organization — tenant-isolated"""
  organizationMembers(organizationId: ID!): [OrganizationMember!]!
  """Active compliance policy for organization"""
  activeCompliancePolicy(organizationId: ID!): CompliancePolicy
  """Published compliance policy versions"""
  compliancePolicyVersions(organizationId: ID!, limit: Int = 20): [CompliancePolicy!]!
  """Current user's consents"""
  myConsents: [Consent!]!
  """Products in organization — tenant-isolated"""
  products(organizationId: ID!, limit: Int = 50): [Product!]!
  """Single product — tenant-isolated"""
  product(organizationId: ID!, productId: ID!): Product
  """User experiences for product — tenant-isolated"""
  userExperiences(organizationId: ID!, productId: ID!): [UserExperience!]!
  """Marketplace import runs — tenant-isolated"""
  marketplaceImportRuns(organizationId: ID!, limit: Int = 20): [MarketplaceImportRun!]!
  """Dataset versions — tenant-isolated"""
  datasetVersions(organizationId: ID!, limit: Int = 20): [DatasetVersion!]!
  """Marketplace reviews for product — tenant-isolated"""
  productMarketplaceReviews(organizationId: ID!, productId: ID!): [MarketplaceReview!]!
  """Single marketplace import run status"""
  marketplaceImportStatus(organizationId: ID!, importRunId: ID!): MarketplaceImportRun
  """Dataset eligibility summary for organization"""
  datasetEligibilitySummary(organizationId: ID!): DatasetEligibilitySummary!
  """Single analysis run — tenant-isolated"""
  agentRun(organizationId: ID!, analysisRunId: ID!): AnalysisRun
  """Analysis runs for organization — tenant-isolated"""
  analysisRuns(organizationId: ID!, status: AnalysisRunStatus, limit: Int = 20): [AnalysisRun!]!
  """Agent run events — append-only progress"""
  agentRunEvents(organizationId: ID!, analysisRunId: ID!, afterSequence: Int = 0, limit: Int = 100): [AgentRunEvent!]!
}

type Mutation {
  register(input: RegisterInput!): RegisterPayload!
  verifyEmail(token: String!): MFASetupPayload!
  confirmMFA(input: ConfirmMFAInput!): Boolean!
  login(input: LoginInput!): LoginPayload!
  verifyLoginMFA(input: VerifyLoginMFAInput!): LoginPayload!
  verifyDevice(input: VerifyDeviceInput!): LoginPayload!
  logout: Boolean!
  refreshToken: Boolean!
  switchWorkspace(organizationId: ID!): Boolean!
  createOrganization(input: CreateOrganizationInput!): Organization!
  inviteMember(input: InviteMemberInput!): Boolean!
  acceptInvitation(token: String!): Organization!
  updateMemberRole(input: UpdateMemberRoleInput!): Boolean!
  removeMember(input: RemoveMemberInput!): Boolean!
  updateOrganizationComplianceProfile(input: UpdateComplianceProfileInput!): Organization!
  publishCompliancePolicyVersion(input: PublishCompliancePolicyInput!): CompliancePolicy!
  grantConsent(input: GrantConsentInput!): Consent!
  withdrawConsent(input: WithdrawConsentInput!): Boolean!
  createProduct(input: CreateProductInput!): CreateProductPayload!
  createUserExperience(input: CreateUserExperienceInput!): UserExperience!
  updateUserExperience(input: UpdateUserExperienceInput!): UserExperience!
  deleteUserExperience(input: DeleteUserExperienceInput!): Boolean!
  moderateUserExperience(input: ModerateUserExperienceInput!): UserExperience!
  startMarketplaceURLImport(input: StartMarketplaceURLImportInput!): MarketplaceImportRun!
  startMarketplaceFileImport(input: StartMarketplaceFileImportInput!): MarketplaceImportRun!
  buildDatasetDraft(input: BuildDatasetDraftInput!): DatasetVersion!
  startAgentRun(input: StartAgentRunInput!): AnalysisRun!
  cancelAgentRun(input: CancelAgentRunInput!): AnalysisRun!
}

input RegisterInput {
  email: String!
  password: String!
}

input ConfirmMFAInput {
  code: String!
}

input LoginInput {
  email: String!
  password: String!
  deviceFingerprint: String!
}

input VerifyLoginMFAInput {
  code: String!
  deviceFingerprint: String!
}

input VerifyDeviceInput {
  code: String!
  deviceFingerprint: String!
}

input CreateOrganizationInput {
  name: String!
  complianceProfile: ComplianceProfile!
}

input InviteMemberInput {
  organizationId: ID!
  email: String!
  role: OrgRole!
}

input UpdateMemberRoleInput {
  organizationId: ID!
  userId: ID!
  role: OrgRole!
}

input RemoveMemberInput {
  organizationId: ID!
  userId: ID!
}

input UpdateComplianceProfileInput {
  organizationId: ID!
  complianceProfile: ComplianceProfile!
}

input PublishCompliancePolicyInput {
  organizationId: ID!
  complianceProfile: ComplianceProfile!
  version: String!
  reason: String!
}

input GrantConsentInput {
  purpose: ConsentPurpose!
  organizationId: ID
}

input WithdrawConsentInput {
  purpose: ConsentPurpose!
  organizationId: ID
}

type User {
  id: ID!
  email: String!
  emailVerified: Boolean!
  mfaEnabled: Boolean!
  personalOrgId: ID!
}

type Workspace {
  organizationId: ID!
  name: String!
  type: OrgType!
  role: OrgRole!
}

type Organization {
  id: ID!
  name: String!
  type: OrgType!
  complianceProfile: ComplianceProfile!
  compliancePolicyVersion: String!
}

type OrganizationMember {
  userId: ID!
  email: String!
  role: OrgRole!
  joinedAt: String!
  invitedAt: String!
}

type CompliancePolicy {
  profile: ComplianceProfile!
  version: String!
  status: PolicyStatus!
  effectiveAt: String!
  reason: String
}

type Consent {
  id: ID!
  purpose: ConsentPurpose!
  policyVersion: String!
  grantedAt: String!
  withdrawnAt: String
  organizationId: ID
}

enum OrgType {
  PERSONAL
  ORGANIZATION
}

enum OrgRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum ComplianceProfile {
  KVKK
  GDPR
  BOTH
}

enum ConsentPurpose {
  REGISTRATION
  ORG_MEMBERSHIP
  DATA_PROCESSING
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LoginStatus {
  MFA_SETUP_REQUIRED
  MFA_REQUIRED
  DEVICE_VERIFICATION_REQUIRED
  AUTHENTICATED
}

type RegisterPayload {
  message: String!
}

type MFASetupPayload {
  secret: String!
  otpauthUrl: String!
}

type LoginPayload {
  status: LoginStatus!
  user: User
}

type ProductFieldMeta {
  value: String
  missing: Boolean!
  missingReason: String
  source: String
  sourceRecordId: String
  confidence: Float
  extractedAt: String
}

type Product {
  id: ID!
  organizationId: ID!
  name: ProductFieldMeta!
  brand: ProductFieldMeta!
  category: ProductFieldMeta!
  description: ProductFieldMeta!
  targetAge: ProductFieldMeta!
  materials: ProductFieldMeta!
  safetyWarnings: ProductFieldMeta!
  currentPrice: ProductFieldMeta!
  originalPrice: ProductFieldMeta!
  currency: ProductFieldMeta!
  seller: ProductFieldMeta!
  rating: ProductFieldMeta!
  reviewCount: ProductFieldMeta!
  attributes: ProductFieldMeta!
  imageRefs: ProductFieldMeta!
  stockStatus: ProductFieldMeta!
  sku: ProductFieldMeta!
  createdAt: String!
  updatedAt: String!
}

type CreateProductPayload {
  product: Product!
  deduplicated: Boolean!
}

type UserExperience {
  id: ID!
  organizationId: ID!
  productId: ID!
  userId: ID!
  usageStatus: UsageStatus!
  satisfactionLevel: SatisfactionLevel!
  rating: Int
  issueType: IssueType
  narrative: String!
  moderationStatus: ModerationStatus!
  qualityStatus: QualityStatus!
  datasetEligibility: DatasetEligibility!
  createdAt: String!
  updatedAt: String!
}

type MarketplaceImportRun {
  id: ID!
  organizationId: ID!
  source: MarketplaceSource!
  sourceUrl: String
  accessMode: AccessMode!
  status: MarketplaceImportStatus!
  recordsSeen: Int!
  recordsAccepted: Int!
  recordsRejected: Int!
  errorCode: String
  errorMessage: String
  createdAt: String!
}

type DatasetVersion {
  id: ID!
  organizationId: ID!
  version: String!
  status: DatasetVersionStatus!
  normalizerVersion: String!
  contentHash: String
  createdAt: String!
}

type MarketplaceReview {
  id: ID!
  organizationId: ID!
  productId: ID!
  source: MarketplaceSource!
  rating: Float
  reviewText: String!
  reviewDate: String
  language: String!
  moderationStatus: ModerationStatus!
  datasetEligibility: DatasetEligibility!
  createdAt: String!
}

type DatasetEligibilitySummary {
  organizationId: ID!
  totalRecords: Int!
  ugcCount: Int!
  marketplaceCount: Int!
  eligibilityDistribution: [EligibilityCount!]!
  sourceDistribution: [SourceCount!]!
}

type EligibilityCount {
  eligibility: DatasetEligibility!
  count: Int!
}

type SourceCount {
  recordType: String!
  count: Int!
}

enum MarketplaceSource {
  HEPSIBURADA
  TRENDYOL
  AMAZON
  N11
  OTHER
  MIYUNA
}

enum AccessMode {
  AUTHORIZED_API
  PERMITTED_PUBLIC_FETCH
  LICENSED_DATASET
  CSV_IMPORT
  JSON_IMPORT
  USER_PROVIDED_FILE
  MANUAL_ENTRY
}

enum UsageStatus {
  USING
  USED
}

enum SatisfactionLevel {
  VERY_SATISFIED
  SATISFIED
  NEUTRAL
  UNSATISFIED
  VERY_UNSATISFIED
}

enum IssueType {
  DURABILITY
  BREAKAGE
  AGE_SIZE_MISMATCH
  MATERIAL
  ODOR
  PACKAGING
  USABILITY
  QUALITY
  SAFETY_RELATED_OBSERVATION
  OTHER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QualityStatus {
  PENDING
  APPROVED
  LOW_QUALITY
  REJECTED
}

enum DatasetEligibility {
  TRAINING_APPROVED
  EVAL_ONLY
  ANALYSIS_ONLY
  QUARANTINED
  REJECTED
}

enum MarketplaceImportStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  REJECTED_BY_POLICY
}

enum DatasetVersionStatus {
  DRAFT
}

input CreateProductInput {
  organizationId: ID!
  name: String!
  brand: String
  category: String
  description: String
  targetAge: String
  materials: String
  safetyWarnings: String
  currentPrice: String
  originalPrice: String
  currency: String
  seller: String
  rating: String
  reviewCount: String
  stockStatus: String
  source: MarketplaceSource!
  sourceProductId: String!
  sourceUrl: String
  sku: String
}

input CreateUserExperienceInput {
  organizationId: ID!
  productId: ID!
  usageStatus: UsageStatus!
  satisfactionLevel: SatisfactionLevel!
  rating: Int
  issueType: IssueType
  narrative: String!
}

input UpdateUserExperienceInput {
  organizationId: ID!
  experienceId: ID!
  usageStatus: UsageStatus!
  satisfactionLevel: SatisfactionLevel!
  rating: Int
  issueType: IssueType
  narrative: String!
}

input DeleteUserExperienceInput {
  organizationId: ID!
  experienceId: ID!
}

input ModerateUserExperienceInput {
  organizationId: ID!
  experienceId: ID!
  moderationStatus: ModerationStatus!
  qualityStatus: QualityStatus
}

input StartMarketplaceURLImportInput {
  organizationId: ID!
  sourceUrl: String!
}

input StartMarketplaceFileImportInput {
  organizationId: ID!
  source: MarketplaceSource!
  accessMode: AccessMode!
  filename: String!
  contentBase64: String!
  contentType: String!
}

input BuildDatasetDraftInput {
  organizationId: ID!
  version: String!
}

input StartAgentRunInput {
  organizationId: ID!
  productId: ID!
  marketplaceImportRunId: ID
  clientRequestId: ID!
}

input CancelAgentRunInput {
  organizationId: ID!
  analysisRunId: ID!
}

type AnalysisRun {
  id: ID!
  organizationId: ID!
  productId: ID!
  marketplaceImportRunId: ID
  clientRequestId: ID!
  status: AnalysisRunStatus!
  currentPhase: String
  traceId: String!
  configSnapshotId: ID!
  toolRegistryVersion: String!
  toolPolicyVersion: String!
  compliancePolicyVersion: String!
  plannerVersion: String!
  iterationCount: Int!
  terminalError: String
  terminalReason: String
  startedAt: String
  completedAt: String
  createdAt: String!
  updatedAt: String!
}

type AgentRunEvent {
  id: ID!
  organizationId: ID!
  analysisRunId: ID!
  sequence: Int!
  phase: String!
  toolName: String
  status: AgentEventStatus!
  metadata: [EventMetadataEntry!]!
  traceId: String!
  timestamp: String!
}

type EventMetadataEntry {
  key: String!
  value: String!
}

enum AnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REJECTED
}

enum AgentEventStatus {
  RUNNING
  COMPLETED
  FAILED
}
